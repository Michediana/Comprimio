    "4:2:0 reduces file size; 4:4:4 preserves color detail (text, graphics)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4:2:0 verringert die Dateigröße; 4:4:4 erhält Farbdetails (Text, Grafiken)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4:2:0 reduce el peso; 4:4:4 conserva el detalle de color (texto, gráficos)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4:2:0 réduit le poids ; 4:4:4 conserve les détails de couleur (texte, graphiques)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4:2:0 riduce il peso; 4:4:4 conserva i dettagli di colore (testo, grafica)."
