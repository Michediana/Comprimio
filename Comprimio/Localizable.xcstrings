    "The aspect ratio is not preserved: the image may be distorted." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Seitenverhältnis bleibt nicht erhalten: Das Bild kann verzerrt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se respetan las proporciones: la imagen puede deformarse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les proportions ne sont pas respectées : l’image peut être déformée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le proporzioni non vengono rispettate: l’immagine può deformarsi."
          }
        }
      }
    },
    "The font “%@” is not available." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Schrift „%@“ ist nicht verfügbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fuente «%@» no está disponible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La police « %@ » n’est pas disponible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il carattere «%@» non è disponibile."
          }
        }
      }
    },
    "The font size is a percentage of the image width. The outline keeps the text readable even over a light area." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Schriftgröße ist ein Prozentsatz der Bildbreite. Die Kontur hält den Text auch über einer hellen Fläche lesbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El cuerpo es un porcentaje del ancho de la imagen. El contorno mantiene el texto legible incluso sobre una zona clara."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le corps est un pourcentage de la largeur de l’image. Le contour garde le texte lisible même sur une zone claire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il corpo è una percentuale della larghezza dell’immagine. Il contorno serve a tenere il testo leggibile anche sopra una zona chiara."
          }
        }
      }
    },
    "The image covers the box and is cropped at the center." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Bild füllt den Rahmen und wird mittig beschnitten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La imagen cubre el recuadro y se recorta por el centro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’image couvre le cadre et est rognée au centre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’immagine copre il rettangolo e viene ritagliata al centro."
          }
        }
      }
    },
    "The image fits inside the box, keeping its aspect ratio." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Bild passt in den Rahmen und behält sein Seitenverhältnis."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La imagen cabe en el recuadro conservando sus proporciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’image tient dans le cadre en conservant ses proportions."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’immagine rientra nel rettangolo mantenendo le proporzioni."
          }
        }
      }
    },
    "The logo file is no longer readable: %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Logodatei ist nicht mehr lesbar: %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
