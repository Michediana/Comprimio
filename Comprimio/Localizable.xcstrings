          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier du logo n’est plus lisible : %@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il file del logo non è più leggibile: %@"
          }
        }
      }
    },
    "The original aspect ratio is preserved." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ursprüngliche Seitenverhältnis bleibt erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se mantienen las proporciones originales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les proportions d’origine sont conservées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le proporzioni originali vengono mantenute."
          }
        }
      }
    },
    "The pixel dimensions stay unchanged." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Pixelmaße bleiben unverändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las dimensiones en píxeles no cambian."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les dimensions en pixels restent inchangées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le dimensioni in pixel restano invariate."
          }
        }
      }
    },
    "The watermark is applied after resizing and color adjustments: it stays in proportion to the final image, and a color logo is left untouched by the grayscale conversion." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Wasserzeichen wird nach Größenänderung und Farbanpassungen angewendet: Es bleibt im Verhältnis zum fertigen Bild, und ein farbiges Logo bleibt von der Graustufen-Umwandlung unberührt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La marca de agua se aplica después del redimensionado y los ajustes de color: se mantiene proporcionada a la imagen final y un logotipo en color no se ve afectado por la escala de grises."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le filigrane est appliqué après le redimensionnement et les réglages de couleur : il reste proportionné à l’image finale, et un logo en couleur n’est pas touché par le passage en niveaux de gris."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La filigrana viene applicata dopo il ridimensionamento e le regolazioni di colore: resta proporzionata all’immagine finale e un logo a colori non viene toccato dalla scala di grigi."
          }
        }
      }
    },
    "This ImageMagick installation cannot write %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
