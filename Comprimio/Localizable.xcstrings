    "A little sharpening recovers detail lost after a heavy downscale." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etwas Schärfe holt Details zurück, die eine starke Verkleinerung gekostet hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un poco de nitidez recupera el detalle perdido tras una reducción fuerte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un peu de netteté récupère les détails perdus après une forte réduction."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un po’ di nitidezza recupera i dettagli persi dopo un ridimensionamento forte."
          }
        }
      }
    },
    "A percentage of the image width, so the same logo stays in proportion across files of different sizes. A PNG with a transparent background gives the best result." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Prozentsatz der Bildbreite: Dasselbe Logo bleibt bei Dateien unterschiedlicher Größe proportional. Ein PNG mit transparentem Hintergrund liefert das beste Ergebnis."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un porcentaje del ancho de la imagen: el mismo logotipo se mantiene proporcionado en archivos de distinto tamaño. Un PNG con fondo transparente da el mejor resultado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un pourcentage de la largeur de l’image : le même logo reste proportionné sur des fichiers de tailles différentes. Un PNG à fond transparent donne le meilleur résultat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Percentuale della larghezza dell’immagine: lo stesso logo resta proporzionato su file di dimensioni diverse. Un PNG con sfondo trasparente dà il risultato migliore."
          }
        }
      }
    },
    "A percentage of the watermark size." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Prozentsatz der Wasserzeichengröße."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un porcentaje del tamaño de la marca de agua."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un pourcentage de la taille du filigrane."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Percentuale della dimensione della filigrana."
          }
        }
      }
    },
