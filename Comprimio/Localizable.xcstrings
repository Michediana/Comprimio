    "%@ does not support transparency: it is flattened automatically." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ unterstützt keine Transparenz: Sie wird automatisch reduziert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no admite transparencia: se aplana automáticamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne prend pas en charge la transparence : elle est aplatie automatiquement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non supporta la trasparenza: viene appiattita automaticamente."
          }
        }
      }
    },
    "%@ has no quality setting." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat keine Qualitätseinstellung."
