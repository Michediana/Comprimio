    "Effort (slower = smaller)" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aufwand (langsamer = kleiner)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esfuerzo (más lento = más comprimido)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Effort (plus lent = plus compressé)"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sforzo (lento = più compresso)"
          }
        }
      }
    },
    "Effort only affects encoding time. “Lossless” matches quality 100: larger than a compressed JPEG XL, but far smaller than a PNG." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Aufwand beeinflusst nur die Kodierzeit. „Verlustfrei“ entspricht Qualität 100: größer als ein komprimiertes JPEG XL, aber weit kleiner als ein PNG."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El esfuerzo solo afecta al tiempo de codificación. «Sin pérdida» equivale a calidad 100: pesa más que un JPEG XL comprimido, pero mucho menos que un PNG."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’effort n’influe que sur le temps d’encodage. « Sans perte » équivaut à la qualité 100 : plus lourd qu’un JPEG XL compressé, mais bien plus léger qu’un PNG."
          }
        },
